# Build image for the attention/accelerator add-on wheels the app installs
# (SageAttention 2/3, FlashAttention, Nunchaku). See build.sh.
#
# Ubuntu 22.04 keeps the wheels loadable on older distributions (glibc 2.35
# here; the built extensions need only what they reference, ~2.32), and its
# GCC 11 is a host compiler CUDA 13 supports.
ARG CUDA_IMAGE=docker.io/nvidia/cuda:13.0.3-devel-ubuntu22.04
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.13.5

FROM ${UV_IMAGE} AS uv

FROM ${CUDA_IMAGE}
ARG PYTHON_VERSION=3.12
ARG TORCH_VERSION=2.14.1
ARG TORCH_INDEX=https://download.pytorch.org/whl/cu130

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates build-essential ninja-build \
    && rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /usr/local/bin/uv

ENV UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_LINK_MODE=copy \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH
RUN uv venv --seed --python ${PYTHON_VERSION} /opt/venv \
    && uv pip install --python /opt/venv/bin/python \
        "torch==${TORCH_VERSION}" --index-url ${TORCH_INDEX} \
    && uv pip install --python /opt/venv/bin/python \
        setuptools wheel packaging ninja numpy psutil pybind11 einops
