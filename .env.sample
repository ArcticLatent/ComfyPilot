# ComfyPilot catalog configuration
#
# Copy this file to .env for local development and fill in your own Supabase
# project values. Never commit a real .env file.

# Backend/admin-only. Useful for one-off maintenance with Supabase CLI, but not
# required by the desktop app and not safe to ship.
ARCTIC_SUPABASE_DATABASE_URL=

# Required for desktop app catalog reads.
ARCTIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Required for the desktop app. Use a public read key with Row Level Security
# that allows selecting only catalog_documents where catalog_key = 'main'.
ARCTIC_SUPABASE_ANON_KEY=

# Alternative name supported by the app. Leave empty if using
# ARCTIC_SUPABASE_ANON_KEY above.
ARCTIC_SUPABASE_PUBLISHABLE_KEY=

# Backend/admin-only. Do not use this in a shipped desktop client.
ARCTIC_SUPABASE_SERVICE_ROLE_KEY=

# Optional. The app only reads preview_image_url values from the catalog and
# does not query storage directly.
ARCTIC_SUPABASE_STORAGE_BUCKET=workflow-previews
